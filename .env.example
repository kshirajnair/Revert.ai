# Copy to .env and edit. Never commit .env.

# Database: SQLite file by default. Postgres/Supabase works too, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/revert
DATABASE_URL=sqlite:///./revert.db

# Accounting connector: mock_tally | tally_xml (Phase 5) | csv (Phase 5)
CONNECTOR=mock_tally
# Mock and real TallyPrime both listen here; switching is just CONNECTOR + this URL.
TALLY_URL=http://localhost:9000
# Leave blank to use whichever company is open in Tally.
TALLY_COMPANY=
TALLY_TIMEOUT_S=15

# Mock Tally server bind address
MOCK_TALLY_HOST=127.0.0.1
MOCK_TALLY_PORT=9000

# Dashboard + chat simulator: python -m revert serve
HOST=127.0.0.1
PORT=8000
# Messaging channel: web_simulator | whatsapp (Phase 4)
CHANNEL=web_simulator
# Background jobs while the server runs (minutes; 0 = off)
SYNC_EVERY_MIN=15
REMIND_EVERY_MIN=15

# AI agent: which LLM reads dealer messages. gemini | claude | openai | rules
# The LLM only classifies messages; replies and every number in them come from the DB.
# With no key for the chosen provider, Revert uses the offline rules classifier (no account needed).
LLM_PROVIDER=gemini
# Blank = provider default (gemini-2.5-flash, claude-haiku-5-5, gpt-4.1-mini)
LLM_MODEL=
LLM_TIMEOUT_S=20
# Free key (Google account needed): https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- WhatsApp Cloud API (set CHANNEL=whatsapp above). Setup steps: README, "WhatsApp setup". ---
# From Meta developer app > WhatsApp > API Setup (temporary token lasts 24h; use a System User token for real use)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; paste the same value into the webhook settings in Meta
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Approved message templates (print their text with: python -m revert wa-templates)
WHATSAPP_REMINDER_TEMPLATE=revert_payment_reminder
WHATSAPP_FOLLOWUP_TEMPLATE=revert_promise_followup
# Where payment screenshots from dealers are saved
MEDIA_DIR=./media
# Password for the dashboard (browser asks; any username). REQUIRED before you open a tunnel for
# the webhook, or anyone with the URL can see your books. Webhooks stay open (Meta signs them).
DASHBOARD_PASSWORD=
